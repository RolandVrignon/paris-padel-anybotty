{
  "name": "paris-padel-anybotty",
  "version": "0.1.0",
  "description": "Prepare high-demand padel bookings and investigate Anybuddy opening windows",
  "keywords": [
    "padel",
    "anybuddy",
    "anybotty",
    "availability"
  ],
  "homepage": "https://github.com/RolandVrignon/paris-padel-anybotty",
  "bugs": {
    "url": "https://github.com/RolandVrignon/paris-padel-anybotty/issues"
  },
  "main": "scripts/anybotty.js",
  "author": "Roland Vrignon; based on par-ici-tennis by Bertrand d’Aure",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RolandVrignon/paris-padel-anybotty.git"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "start": "node scripts/anybotty.js status",
    "clubs:list": "node scripts/anybotty.js clubs",
    "booking:plan": "node scripts/anybotty.js plan",
    "eslint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:reference": "node scripts/test-reference.js",
    "postinstall": "npx playwright install chromium",
    "observe:once": "node scripts/observe.js",
    "observe:report": "node scripts/observe.js --report",
    "config:init": "node scripts/init-config.js",
    "auth:login": "node scripts/login.js",
    "auth:login-headed": "node scripts/login.js --headed",
    "auth:check": "node scripts/login.js --check",
    "auth:login-manual": "node scripts/login.js --headed --manual",
    "checkout:preview": "node scripts/checkout-preview.js",
    "booking:search": "node scripts/booking-search.js",
    "padel": "node scripts/padel.js",
    "hermes:install": "node scripts/install-hermes-skills.js",
    "booking:pay": "node scripts/booking-search.js --pay",
    "booking:reconcile": "node scripts/booking-search.js --reconcile",
    "payment:check": "node scripts/check-payment.js",
    "checkout:audit": "node scripts/audit-payment-routes.js",
    "auth:4padel": "node scripts/login-fourpadel.js"
  },
  "dependencies": {
    "@gradio/client": "^2.6.0",
    "dayjs": "^1.11.23",
    "ics": "^3.12.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
